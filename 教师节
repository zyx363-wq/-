<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>致邓老师 · 教师节快乐</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
        }
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #f8f9fa 0%, #eef2f7 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 24px;
            position: relative;
            overflow: hidden;
        }
        .bg-petal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }
        .card {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 520px;
            background: rgba(255, 255, 255, 0.78);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid rgba(255, 255, 255, 0.7);
            border-radius: 26px;
            box-shadow: 0 10px 32px rgba(120, 130, 160, 0.18);
            padding: 48px 36px;
            text-align: center;
        }
        .card-top-line {
            width: 64px;
            height: 5px;
            background: linear-gradient(90deg, #b8273b, #e04b5f);
            border-radius: 3px;
            margin: 0 auto 32px;
        }
        .title {
            font-size: 34px;
            font-weight: 600;
            color: #2c2c2c;
            margin-bottom: 24px;
            letter-spacing: 1.5px;
        }
        .title span {
            color: #c02a3e;
        }
        .typewriter-box {
            min-height: 100px;
            margin-bottom: 32px;
        }
        .typewriter {
            font-size: 17px;
            line-height: 1.9;
            color: #444;
            overflow: hidden;
            white-space: pre-wrap;
        }
        .blink {
            animation: blink 1s infinite;
        }
        @keyframes blink {
            0%,100%{opacity:1;}
            50%{opacity:0;}
        }
        .wish {
            font-size: 21px;
            color: #333;
            font-weight: 500;
            margin-bottom: 36px;
            line-height: 1.6;
        }
        .heart {
            color: #c02a3e;
            animation: heartbeat 1.4s ease-in-out infinite;
        }
        @keyframes heartbeat {
            0% { transform: scale(1); }
            50% { transform: scale(1.15); }
            100% { transform: scale(1); }
        }
        .btn-wrap{
            display:flex;
            gap:12px;
            justify-content:center;
        }
        .btn {
            border: none;
            border-radius: 50px;
            padding: 10px 24px;
            font-size: 14px;
            cursor: pointer;
            transition: 0.3s ease;
        }
        .btn-music{
            background: linear-gradient(135deg, #b8273b, #e04b5f);
            color: #fff;
        }
        .btn-music:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 14px rgba(192, 42, 62, 0.35);
        }
        .btn-reset{
            background:#e9ecef;
            color:#444;
        }
        .btn-reset:hover{
            background:#dee2e6;
        }
    </style>
</head>
<body>
    <canvas class="bg-petal" id="bgPetal"></canvas>
    <div class="card">
        <div class="card-top-line"></div>
        <div class="title">致<span>邓老师</span></div>
        <div class="typewriter-box">
            <div class="typewriter" id="typewriter"></div>
        </div>
        <div class="wish">
            祝您教师节快乐<br>
            身体健康，万事顺遂，桃李芬芳<span class="heart"> ❤</span>
        </div>
        <div class="btn-wrap">
            <button class="btn btn-music" onclick="toggleMusic()">🎵 背景音乐</button>
            <button class="btn btn-reset" onclick="restartAnim()">🔄 重新播放动画</button>
        </div>
    </div>

    <audio id="bgAudio" loop preload="auto">
        <source src="https://cdn.jsdelivr.net/gh/itxcr/oss/music/teacher.mp3" type="audio/mpeg">
    

<script>
// 花瓣飘落动画
const canvas = document.getElementById('bgPetal');
const ctx = canvas.getContext('2d');
let w,h;
function resize(){
    w=canvas.width=window.innerWidth;
    h=canvas.height=window.innerHeight;
}
resize();
window.addEventListener('resize',resize);

const petals = [];
class Petal{
    constructor(){
        this.x = Math.random()*w;
        this.y = Math.random()*-h;
        this.size = Math.random()*8+4;
        this.speedY = Math.random()*1.2+0.4;
        this.speedX = Math.random()*0.6-0.3;
        this.rotate = Math.random()*Math.PI*2;
        this.rotateSpeed = (Math.random()-0.5)*0.02;
    }
    update(){
        this.y += this.speedY;
        this.x += this.speedX;
        this.rotate += this.rotateSpeed;
        if(this.y>h){
            this.y = -20;
            this.x = Math.random()*w;
        }
    }
    draw(){
        ctx.save();
        ctx.translate(this.x,this.y);
        ctx.rotate(this.rotate);
        ctx.fillStyle="rgba(224,75,95,0.22)";
        ctx.beginPath();
        ctx.ellipse(0,0,this.size,this.size*0.6,0,0,Math.PI*2);
        ctx.fill();
        ctx.restore();
    }
}
for(let i=0;i<35;i++) petals.push(new Petal());

function animate(){
    ctx.clearRect(0,0,w,h);
    petals.forEach(p=>{p.update();p.draw();});
    requestAnimationFrame(animate);
}
animate();

//打字机
const text = `三尺讲台，四季耕耘。
感谢您用耐心与智慧，点亮每一段成长的路。
教诲如灯，铭记于心。`;
const dom = document.getElementById('typewriter');
let idx=0;
function type(){
    if(idx<=text.length){
        dom.innerText = text.substring(0,idx)+'<span class="blink">|</span>';
        idx++;
        setTimeout(type,90);
    }else{
        dom.innerHTML = text;
    }
}
type();

function restartAnim(){
    idx=0;
    type();
}

// 音乐控制，增加捕获错误
const audio = document.getElementById('bgAudio');
let isPlay = false;
function toggleMusic(){
    if(!isPlay){
        audio.play().catch(err=>{
            console.log("音乐播放失败：",err);
            alert("请点击页面后再尝试播放音乐");
        });
        isPlay=true;
    }else{
        audio.pause();
        isPlay=false;
    }
}
</script>
</body>
</html>
